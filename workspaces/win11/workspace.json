{
  "friendly_name": "Windows 11 (Dockur)",
  "image_src": "windows-11.png",
  "description": "Windows 11 VM via dockurr/windows (QEMU/KVM). Exposes web viewer on 8006 and RDP on 3389.",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": ["Desktop"],
  "architecture": ["amd64"],

  "cores": 4,
  "memory": 8192,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",

  "volume_mappings": {
    "/mnt/kasm_user_share/windows": {
      "bind": "/storage",
      "mode": "rw",
      "uid": 1000,
      "gid": 1000,
      "required": true,
      "skip_check": false
    }
  },

  "run_config": {
    "hostname": "kasm",
    "devices": [
      "/dev/kvm",
      "/dev/net/tun"
    ],
    "cap_add": [
      "NET_ADMIN"
    ],
    "environment": {
      "VERSION": "11"
    },
    "ports": {
      "8006": 8006,
      "3389/tcp": 3389,
      "3389/udp": 3389
    },
    "stop_timeout": 120
  },

  "exec_config": {},

  "compatibility": [
    {
      "version": "1.18.x",
      "image": "dockurr/windows:latest",
      "uncompressed_size_mb": 0
    }
  ]
}