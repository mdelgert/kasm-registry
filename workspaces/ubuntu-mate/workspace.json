{
  "friendly_name": "Ubuntu MATE",
  "image_src": "ubuntu-mate.png",
  "description": "Ubuntu with the MATE desktop environment.",
  "docker_registry": "https://ghcr.io/",
  "categories": ["Desktop"],
  "architecture": ["amd64", "arm64"],
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "image_type": "Container",
  "run_config": {
    "hostname": "kasm",
    "security_opt": ["seccomp=unconfined"],
    "entrypoint": ["/kasminit"],
    "user": 1000,
    "environment": {
      "HOME": "/home/kasm-user"
    }
  },
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "lscr.io/linuxserver/webtop:ubuntu-mate",
      "uncompressed_size_mb": 2270
    },
    {
      "version": "1.18.x",
      "image": "lscr.io/linuxserver/webtop:ubuntu-mate",
      "uncompressed_size_mb": 2270
    }
  ]
}